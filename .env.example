# LLM Configuration
# Lựa chọn Provider: gemini | openrouter | openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# API Keys (Điền ít nhất 1 key tương ứng với Provider bạn dùng)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# Chỉ set nếu OPENAI_API_KEY là key của một proxy/reseller tương thích OpenAI
# (không phải key OpenAI gốc) — để trống thì mặc định dùng api.openai.com.
# BASE_URL=https://your-proxy-endpoint.example/v1

# Server Configuration
PORT=8000

# Chỉ set nếu máy bạn gặp lỗi CERTIFICATE_VERIFY_FAILED khi gọi API (thường do
# phần mềm diệt virus / proxy công ty chặn và ký lại HTTPS bằng chứng chỉ riêng).
# Trỏ tới file .pem chứng chỉ gốc đó — không commit giá trị thật của dòng này.
# EXTRA_CA_BUNDLE=

